<Window
    x:Class="WPFApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="495"
    mc:Ignorable="d">



    <Grid Margin="0,0,0,-6">
        <Grid.Background>
            <ImageBrush />
        </Grid.Background>


        <Button
            x:Name="btn_uc"
            Height="40"
            Margin="223,375,417,0"
            VerticalAlignment="Top"
            Click="btn_uc_Click"
            Content="SignUp"
            FontSize="16"
            FontWeight="Bold"
            Foreground="White">
            <Button.Background>
                <SolidColorBrush Opacity="1" Color="#FF5847AF" />
            </Button.Background>



        </Button>



        <Button
            Width="148"
            Height="40"
            Margin="438,375,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="Button_Click_1"
            Content="Close"
            FontSize="16"
            FontWeight="Bold" />


        <Label
            x:Name="main_info_text"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Content="No Data Available"
            FontSize="30"
            FontWeight="Bold" />



        <DataGrid
            x:Name="myDG"
            Height="227"
            Margin="10,134,10,0"
            VerticalAlignment="Top"
            AlternatingRowBackground="#FFD0D0D0"
            AlternationCount="2"
            AutoGenerateColumns="True"
            CanUserAddRows="False"
            CanUserResizeRows="False"
            CanUserSortColumns="True"
            ColumnWidth="*"
            IsReadOnly="True">


            <DataGrid.Resources>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Background" Value="Yellow" />
                    <Setter Property="BorderThickness" Value="1,0,1,2" />
                    <Setter Property="BorderBrush" Value="Black" />

                </Style>

                <!--<Style x:Key="HighlightedRowStyle" TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                            <Setter Property="Background" Value="Green" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>-->


            </DataGrid.Resources>
            <DataGrid.Background>
                <SolidColorBrush Opacity="0.5" Color="#FFF0F0F0" />
            </DataGrid.Background>


            <!--<DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding UserName}"
                    Header="Name" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding UserEmail}"
                    Header="Email" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding UserPassword}"
                    Header="Password" />
            </DataGrid.Columns>-->







        </DataGrid>


        <!--<StackPanel Margin="6,14,477,92">
            <UC:login Width="300" Height="347" />
        </StackPanel>-->





        <TextBox
            x:Name="search_box"
            Width="245"
            Height="32"
            Margin="43,72,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            TextWrapping="Wrap">
            <TextBox.Background>
                <SolidColorBrush Opacity="0.8" Color="White" />
            </TextBox.Background>
        </TextBox>


        <Button
            x:Name="btn_search"
            Width="67"
            Height="32"
            Margin="315,72,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="btn_search_Click"
            Content="Search" />




        <Button
            x:Name="btn_del_data"
            Width="116"
            Height="32"
            Margin="653,27,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="btn_del_data_Click"
            Content="Delete Data"
            FontSize="16"
            FontWeight="Bold" />


        <Button
            x:Name="btn_undo_data"
            Width="116"
            Height="32"
            Margin="653,72,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="btn_undo_data_Click"
            Content="Undo Data"
            FontSize="16"
            FontWeight="Bold" />

        <Label
            x:Name="rowCountLabel"
            Margin="10,107,666,0"
            VerticalAlignment="Top"
            Content="Row Count: " />
        <DockPanel
            Width="800"
            Height="28"
            Margin="0,0,0,-2"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#FF5847AF"
            LastChildFill="False" />
    </Grid>
</Window>
