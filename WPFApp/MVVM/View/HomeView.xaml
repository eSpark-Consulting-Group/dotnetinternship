<UserControl
    x:Class="ModernDesign.MVVM.View.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ModernDesign.MVVM.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="460"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel>
        <TextBlock
            Margin="0,0,0,20"
            HorizontalAlignment="Left"
            FontSize="28"
            Foreground="White"
            Text="Discover" />


        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
            <Border Width="400" Height="200">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,2">
                        <GradientStop Offset="0.0" Color="#FF6EC8FB" />
                        <GradientStop Offset="1" Color="#FF0C3F6F" />

                    </LinearGradientBrush>
                </Border.Background>

                <Border.Clip>
                    <RectangleGeometry
                        RadiusX="10"
                        RadiusY="10"
                        Rect="0,0,400,200" />
                </Border.Clip>

                <Grid>


                    <Image
                        Margin="-122,-137,-94,-143"
                        Opacity="0.2"
                        RenderTransformOrigin="0.5,0.5"
                        Source="/Images/a.png">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1" />
                                <SkewTransform />
                                <RotateTransform />
                                <TranslateTransform />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>


                    <StackPanel>
                        <TextBlock
                            Margin="20,10,10,0"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="World Leader&#xA;in gobal finance" />

                        <TextBlock
                            Margin="20,10,10,0"
                            FontSize="18"
                            Foreground="White"
                            Text="Get started today!" />

                    </StackPanel>


                    <Image Margin="151,-27,-66,-71" Source="/Images/a.PNG" />


                </Grid>

            </Border>

            <Border
                Width="200"
                Height="200"
                Margin="45,0,0,0"
                CornerRadius="10">


                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0" Color="#FFFFCF70" />
                        <GradientStop Offset="1" Color="#FFFFA200" />
                    </LinearGradientBrush>
                </Border.Background>


            </Border>

        </StackPanel>



        <StackPanel>

            <StackPanel.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Margin" Value="15,0,0,0" />

                </Style>
            </StackPanel.Resources>


            <TextBlock
                Margin="0,0,0,10"
                HorizontalAlignment="Left"
                FontSize="20"
                Foreground="White"
                Text="Most watched" />

            <StackPanel Orientation="Horizontal">

                <Border
                    Width="150"
                    Height="150"
                    Margin="0"
                    Background="#844eff"
                    CornerRadius="10" />

                <Border
                    Width="150"
                    Height="150"
                    Background="#FF58DC6D"
                    CornerRadius="10" />

                <Border
                    Width="150"
                    Height="150"
                    Background="#FFE86DD8"
                    CornerRadius="10" />

                <Border
                    Width="150"
                    Height="150"
                    Background="#FFF6FF4E"
                    CornerRadius="10" />

            </StackPanel>

        </StackPanel>

    </StackPanel>
</UserControl>
